# Permanent redirect only — no LipaBill app on the deploy host.
# Install into /Users/mizu/server/Caddyfile, then:
#   docker exec server-caddy-1 caddy reload --config /etc/caddy/Caddyfile
# (Cloudflare tunnel home_mac → docker Caddy on 127.0.0.1:8080)

http://lipabill.mboya.dev {
	redir https://lipabill.app{uri} permanent
}
