# Copy to `.kamal/secrets` (gitignored). Kamal parses this as dotenv — not bash.
#
# Add to .env.local (gitignored):
#   KAMAL_REGISTRY_PASSWORD=ghp_...   # GHCR PAT with write:packages

KAMAL_REGISTRY_PASSWORD=$(grep ^KAMAL_REGISTRY_PASSWORD= .env.local 2>/dev/null | head -1 | cut -d= -f2-)
GOOGLE_SHEETS_WEBHOOK_URL=$(grep ^GOOGLE_SHEETS_WEBHOOK_URL= .env.local 2>/dev/null | head -1 | cut -d= -f2-)
